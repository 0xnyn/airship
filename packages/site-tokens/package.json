{
  "name": "@airship/site-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./editor-mock.css": "./dist/editor-mock.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/gen.mjs && tsup src/index.ts --format esm --dts --sourcemap --clean && node scripts/postbuild.mjs",
    "clean": "node ../../scripts/clean.mjs dist .turbo",
    "gen": "node scripts/gen.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@airship/editor-tokens": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "yaml": "^2.6.1"
  }
}
