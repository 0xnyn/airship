{
  "name": "airship",
  "version": "0.0.0",
  "private": true,
  "description": "Airship \u2014 a visual editor for your running web app, driven by Claude Code, Codex or OpenCode",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@airship/web",
    "clean": "turbo run clean",
    "commit": "czg",
    "dev": "turbo run dev",
    "dev:pkgs": "turbo run dev --filter=./packages/*",
    "dev:web": "turbo run dev --filter=@airship/web",
    "fix": "ultracite fix",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.5",
    "czg": "^1.14.0",
    "husky": "^9.1.7",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "ultracite": "^8.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=22.18.0"
  }
}
